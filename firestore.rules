rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Публично четене — само Админ пише
    match /tours/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /posts/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /reviews/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Публично създаване (форми на сайта) — само Админ чете/редактира/трие
    match /inquiries/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /subscribers/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 3. CRM / ERP — само Админ (изрично, не само чрез catch-all)
    match /customers/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /campaigns/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /bookings/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /departures/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /groups/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /media/{document=**} {
      allow read, write: if request.auth != null;
    }

    // AI чат въпроси — пишат се само от Cloud Function (Admin SDK, заобикаля всички правила), четат се само
    // от admin API route-а (също чрез Admin SDK). Това правило е чисто за яснота/бъдеща поддръжка
    // (ако някога се преминава към client SDK четене), не публично четимо — може да съдържа лична
    // информация в текста на въпросите.
    match /chatQuestions/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Постоянен черен списък с отхвърлени тур линкове (/api/scout ги чете, за да не ги предлага пак
    // като "нови") — нарочно СЕПАРАТНА от самите турове документи, така че изтриването на тур да не махва
    // и решението да го игнорираме. Публично четима като tours — /api/scout е сървърен route, който чете
    // с клиентския SDK БЕЗ логнат сесия (request.auth винаги е null там) — ако това поле изисква auth,
    // всяко сканиране би гръмнало с permission denied.
    match /ignoredTourUrls/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 4. Catch-all — всичко останало изисква автентикация
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
