rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Публично четене — само Админ пише
    match /tours/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /posts/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /reviews/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Публично създаване (форми на сайта) — само Админ чете/редактира/трие
    match /inquiries/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /subscribers/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 3. CRM / ERP — само Админ (изрично, не само чрез catch-all)
    match /customers/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /campaigns/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /bookings/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /departures/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /groups/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /media/{document=**} {
      allow read, write: if request.auth != null;
    }

    // 4. Catch-all — всичко останало изисква автентикация
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
